{
  "name": "mychat",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch --experimental-strip-types src/server.ts\" \"next dev --port 5173\"",
    "build": "next build && esbuild src/server.ts --bundle --platform=node --format=esm --outfile=server.mjs --packages=external",
    "start": "node server.mjs",
    "check": "node --experimental-strip-types src/check.ts"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@hono/node-ws": "^1.2.0",
    "hono": "^4.9.8",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2"
  }
}
